{
  "expo": {
    "name": "Memento",
    "slug": "MemoryTicket",
    "version": "2.5.0",
    "orientation": "portrait",
    "icon": "./assets/Memento-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Memento-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#34345C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salera.memoryticket",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "instagram",
          "fb",
          "whatsapp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Memento-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.salera.memoryticket",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3404665145185739~3242147488"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MemoryTicket to access your photos so you can create memories."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [],
              "doNotStrip": []
            }
          }
        }
      ],
      "expo-asset",
      "expo-local-authentication",
      "expo-notifications",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Memento",
              "label": "Memento",
              "minWidth": "180dp",
              "minHeight": "100dp",
              "description": "Your memories at a glance",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "39c9d6d9-62d6-40d1-96f5-746f16355596"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/39c9d6d9-62d6-40d1-96f5-746f16355596"
    },
    "owner": "salman_saeed"
  }
}
